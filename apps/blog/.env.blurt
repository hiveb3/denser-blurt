# Blurt port of Denser - local / VPS configuration
DENSER_SERVER_ENV_DUMP=true
REACT_APP_CHAIN="blurt"
REACT_APP_APP_NAME="blog"
# Must be Nexus nodes (bridge API). Comma separated list used for failover/broadcast.
REACT_APP_API_ENDPOINT="https://rpc.beblurt.com"
REACT_APP_BLURT_NODES="https://rpc.beblurt.com,https://rpc.blurt.world,https://blurt-rpc.saboin.com"
REACT_APP_CHAIN_ID="cd8d90f29ae273abec3eaa7731e25934c63eb654d55080caff2ebb7f5df6381f"
REACT_APP_IMAGES_ENDPOINT="https://imgp.blurt.world/"
REACT_APP_AI_DOMAIN=""
REACT_APP_SITE_DOMAIN="http://localhost:3000"
REACT_APP_BLOG_DOMAIN="http://localhost:3000"
REACT_APP_WALLET_ENDPOINT="http://localhost:4000"
REACT_APP_EXPLORER_DOMAIN=""  # set a Blurt block explorer here
REACT_APP_APP_SESSION_TIME=64800
REACT_APP_LOGGING_BROWSER_ENABLED="false"
REACT_APP_LOGGING_LOG_LEVEL="info"
REACT_APP_ALLOW_NON_STRICT_LOGIN="yes"
REACT_APP_LOGIN_AUTHENTICATE_ON_BACKEND="no"
DENSER_SERVER_SECRET_COOKIE_PASSWORD="CHANGE-ME-to-a-long-random-string-32chars"
DENSER_SERVER_OIDC_ENABLED="no"
REACT_APP_OPENHIVE_CHAT_IFRAME_INTEGRATION_ENABLE="no"
REACT_APP_ENABLE_THIRD_PARTY_API=false
ESLINT_USE_FLAT_CONFIG=false
